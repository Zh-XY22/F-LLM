{
  "source_tsf": "${M3_MONTHLY_TSF}",
  "target_tsf": "${M4_MONTHLY_TSF}",
  "llama_checkpoint": "${LLAMA_CHECKPOINT}",
  "output_dir": "./outputs/monthly_m3_to_m4_h18",
  "plant_seed": 2022,
  "observer_seed": 2027,
  "plant": {
    "seq_len": 48,
    "label_len": 24,
    "token_len": 24,
    "test_seq_len": 24,
    "test_label_len": 0,
    "test_pred_len": 24,
    "seasonal_patterns": "Monthly",
    "dropout": 0.1,
    "mlp_hidden_dim": 512,
    "mlp_hidden_layers": 2,
    "mlp_activation": "tanh",
    "num_workers": 10,
    "drop_last": false,
    "val_set_shuffle": false,
    "drop_short": false,
    "batch_size": 16,
    "train_epochs": 10,
    "patience": 3,
    "learning_rate": 0.00001,
    "loss": "SMAPE",
    "lradj": "type1",
    "use_amp": true,
    "cosine": true,
    "tmax": 10,
    "weight_decay": 0,
    "mix_embeds": false
  },
  "evaluation": {
    "generated_points_per_step": 24,
    "scored_points": 18,
    "feedback_factor": 1.0,
    "smape_epsilon": 0.00000001
  }
}

